# Shared infra environment — copy to .env and fill in.

# Domain that subprojects subdomain off (testmaster.<DOMAIN>, s3.<DOMAIN>, …).
DOMAIN=example.uz

# Let's Encrypt notifications (expiry, rate-limits). Required by Caddy.
ACME_EMAIL=you@example.uz

# Postgres root credentials. Used by init-databases.sh and by
# provision_project.sh when adding more projects.
POSTGRES_ROOT_PASSWORD=change-me-to-a-long-random-string

# Initial testmaster DB password (used only on first compose up — when
# init-databases.sh runs). After that, rotate via psql ALTER ROLE.
TESTMASTER_DB_PASSWORD=change-me-too

# MinIO root credentials. Provision_project.sh creates per-project
# service-accounts with scoped bucket policies; these stay admin-only.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-to-a-long-random-string
