# /srv/testmaster/.env — per-project secrets and config.
# Copy to .env, fill in, then `docker compose up -d --build`.

# Domain shared with the infra stack; used by caddy to route requests
# and by the app to build presigned URLs and reset links.
DOMAIN=example.uz

# App-side secrets.
SECRET_KEY=generate-with-openssl-rand-hex-32
APP_VERSION=dev

# CORS: only the SPA's origin should match.
ALLOWED_ORIGINS=https://testmaster.example.uz

# Public origin for absolute links in emails.
PUBLIC_BASE_URL=https://testmaster.example.uz

# Postgres connection — must match the role created by init-databases.sh
# (or by scripts/provision_project.sh for subsequent projects). Uses the
# data-network hostname `postgres`.
DATABASE_URL=postgresql+psycopg2://testmaster_user:change-me-too@postgres:5432/testmaster

# MinIO service account scoped to the testmaster-* buckets. Provisioned
# by scripts/provision_project.sh; rotate via `mc admin user` if leaked.
S3_ACCESS_KEY=testmaster_app
S3_SECRET_KEY=change-me-too
S3_BUCKET_ASSETS=testmaster-assets
S3_BUCKET_AVATARS=testmaster-avatars
S3_REGION=us-east-1

# Mail. Start with Resend; flip MAIL_PROVIDER=smtp + set SMTP_* once the
# free tier is exhausted.
MAIL_PROVIDER=resend
MAIL_FROM=noreply@example.uz
MAIL_REPLY_TO=
RESEND_API_KEY=re_...

# Optional: Inkscape handles WMF/EMF in the container, but for the
# occasional broken docx CloudConvert is a useful fallback.
# CLOUDCONVERT_API_KEY=

# Session tuning (defaults are fine in most cases).
ACCESS_TOKEN_EXPIRE_MINUTES=60
ABANDONED_RETENTION_DAYS=90

# This marks the environment as production so SECRET_KEY placeholder
# refuses to boot.
ENV=production
